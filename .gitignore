# Python 与本机环境
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-*/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
.idea/
.vscode/
.env
.env.*
!.env.example

# 模型、实验输出及复现辅助文件纳入版本管理。
# 按用户选择，原始数据和处理后数据不上传。
data/raw/*
!data/raw/README.md
data/processed/*
!data/processed/README.md
# 临时安装的第三方工具和下载缓存可由依赖文件重建。
tmp/*_wheels/
tmp/refit_archive_tools/
